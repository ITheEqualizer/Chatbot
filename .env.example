# Copy to `.env` and adjust. These are read via os.environ in chatbot/settings.py.
# (.env itself is gitignored; export these in your shell or process manager.)

# --- Django core ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-in-production
# True for local development, False in production.
DJANGO_DEBUG=True
# Comma-separated hostnames allowed to serve the app (required when DEBUG=False).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Chatbot ---
# "en" -> ChatBot.bin + English preprocessor; "fa" -> ChatBot_Persian.bin + hazm.
CHATBOT_LANGUAGE=en
# Override the FastText model file path (defaults follow CHATBOT_LANGUAGE).
# MODEL_PATH=ChatBot.bin
# Minimum cosine similarity (0-1) for a stored answer; below this -> fallback reply.
SIMILARITY_THRESHOLD=0.85

# Logging level for the "bot" logger (DEBUG, INFO, WARNING, ERROR).
BOT_LOG_LEVEL=INFO
